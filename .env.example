# Supabase 프로젝트 설정 (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# API 키 암호화용 서버 전용 비밀키. 클라이언트에는 노출되지 않는다.
# 생성 예: openssl rand -base64 32
NUXT_API_KEY_ENCRYPTION_SECRET=

# 네이버 검색 API(지역) - 업체명/주소 자동조회용. 서비스 공용 키(운영자 본인 발급)이며 사용자별로 저장하지 않는다.
# 네이버 개발자센터(https://developers.naver.com/apps)에서 애플리케이션 등록 후 "검색" API 사용 설정 시 발급된다.
NUXT_NAVER_CLIENT_ID=
NUXT_NAVER_CLIENT_SECRET=
